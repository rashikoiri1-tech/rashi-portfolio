{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Portfolio with Vite, React, TypeScript, Express, and 240-frame Canvas Animation",
  "scripts": {
    "dev": "node dev.js",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "generate:frames": "node scripts/generate-frames.js",
    "generate:images": "node scripts/generate-project-images.js",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend"
  },
  "keywords": [
    "portfolio",
    "full-stack",
    "react",
    "vite",
    "typescript",
    "express",
    "canvas"
  ],
  "author": "",
  "license": "MIT"
}
